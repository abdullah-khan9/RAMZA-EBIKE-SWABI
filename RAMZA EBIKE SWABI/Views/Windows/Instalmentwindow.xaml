<Window x:Class="Ramza_EBike_Swabi.Views.Windows.InstalmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalment Plan"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A3C5E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8 5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A3C5E" CornerRadius="10" Padding="16 12" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="📅 Instalment Plan" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubTitle" FontSize="12" Foreground="#94A3B8" Margin="0 4 0 0"/>
            </StackPanel>
        </Border>

        <!-- Setup Row -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14 12" Margin="0 0 0 12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#CBD5E1" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Number of Instalments:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0 0 10 0"/>
                <ComboBox x:Name="cmbCount" Width="70" Height="32"
                          SelectionChanged="CmbCount_Changed">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>
                <TextBlock Text="Start Date:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="20 0 10 0"/>
                <DatePicker x:Name="dpStart" Width="130" Height="32"
                            SelectedDateChanged="DpStart_Changed"/>
                <Button Content="↻ Auto Fill" Width="90" Height="32" Margin="16 0 0 0"
                        Background="#2563EB" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand" Click="AutoFill_Click"/>
            </StackPanel>
        </Border>

        <!-- Remaining info -->
        <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="6" Padding="12 8" Margin="0 0 0 10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Remaining Amount:" FontWeight="Bold" Margin="0 0 8 0"/>
                <TextBlock x:Name="RemainingText" FontWeight="Bold" Foreground="#1D4ED8" FontSize="15"/>
                <TextBlock Text="   |   Allocated:" Margin="16 0 8 0" Foreground="#666"/>
                <TextBlock x:Name="AllocatedText" FontWeight="Bold" Foreground="#16A34A" FontSize="15"/>
                <TextBlock x:Name="DiffText" Margin="16 0 0 0" FontWeight="Bold" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Instalment Grid -->
        <DataGrid x:Name="dgInstalments" Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False"
                  RowHeight="36"
                  FontSize="13"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF2F7"
                  BorderThickness="0"
                  ColumnHeaderStyle="{StaticResource ColHeader}"
                  CellEditEnding="DgInstalments_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding InstalmentNumber}"
                                    IsReadOnly="True" Width="40"/>
                <DataGridTemplateColumn Header="Due Date" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DueDateDisplay}" Padding="8 0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                        Height="30" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Amount (PKR)"
                                    Binding="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>
                <DataGridTextColumn Header="Remarks"
                                    Binding="{Binding Remarks, Mode=TwoWay}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Total check -->
        <TextBlock x:Name="ValidationText" Grid.Row="4"
                   Margin="0 8 0 0" FontSize="12" FontWeight="Bold"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="Cancel" Width="100" Height="38" Margin="0 0 10 0"
                    Background="#64748B" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="✔ Save Plan" Width="130" Height="38"
                    Background="#16A34A" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
