<Window x:Class="Ramza_EBike_Swabi.Views.Windows.InstalmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalment Details"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#F0F4F8">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A3C5E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8 5"/>
        </Style>
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Paid">
                    <Setter Property="Background" Value="#F0FDF4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                    <Setter Property="Background" Value="#FFF5F5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A3C5E" CornerRadius="10" Padding="16 12" Margin="0 0 0 14">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubTitleText" FontSize="12" Foreground="#94A3B8" Margin="0 4 0 0"/>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14 10" Margin="0 0 0 12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#CBD5E1" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0 0 24 0">
                    <TextBlock Text="Total" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TotalText" FontSize="15" FontWeight="Bold" Foreground="#1A3C5E"/>
                </StackPanel>
                <StackPanel Margin="0 0 24 0">
                    <TextBlock Text="Paid" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="PaidText" FontSize="15" FontWeight="Bold" Foreground="#16A34A"/>
                </StackPanel>
                <StackPanel Margin="0 0 24 0">
                    <TextBlock Text="Remaining" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="RemainingText" FontSize="15" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Next Due" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="NextDueText" FontSize="15" FontWeight="Bold" Foreground="#D97706"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <DataGrid x:Name="dgInstalments" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  RowHeight="38" FontSize="13"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF2F7"
                  BorderThickness="0"
                  RowStyle="{StaticResource RowStyle}"
                  ColumnHeaderStyle="{StaticResource ColHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding InstalmentNumber}" Width="40"/>
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDateFormatted}" Width="120"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountFormatted}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Paid On" Binding="{Binding PaidOnFormatted}" Width="120"/>
                <DataGridTextColumn Header="Paid Amount" Binding="{Binding PaidAmountFormatted}" Width="115"/>
                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✔ Pay"
                                    Width="80" Height="28"
                                    Background="#16A34A" Foreground="White"
                                    BorderThickness="0" FontWeight="Bold"
                                    Cursor="Hand"
                                    Visibility="{Binding CanPayVisibility}"
                                    Click="MarkPaid_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Close Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="Close" Width="100" Height="36"
                    Background="#64748B" Foreground="White"
                    BorderThickness="0" FontWeight="Bold"
                    Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
