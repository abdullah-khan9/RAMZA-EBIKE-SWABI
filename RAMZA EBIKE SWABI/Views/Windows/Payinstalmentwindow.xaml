<Window x:Class="Ramza_EBike_Swabi.Views.Windows.PayInstalmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pay Instalment"
        Width="420" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Background="#1A3C5E" CornerRadius="8"
                Padding="14 10" Margin="0 0 0 16">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Cash Amount -->
        <StackPanel Grid.Row="1" Margin="0 0 0 12">
            <TextBlock Text="💵 Cash Amount (PKR)" FontWeight="SemiBold"
                       Margin="0 0 0 4" Foreground="#15803D"/>
            <TextBox x:Name="txtCash" Height="36" Padding="10 0"
                     VerticalContentAlignment="Center" FontSize="14"
                     BorderBrush="#E2E8F0" BorderThickness="1.5"
                     Text="0" TextChanged="Recalculate"/>
        </StackPanel>

        <!-- Account Amount -->
        <StackPanel Grid.Row="2" Margin="0 0 0 12">
            <TextBlock Text="🏦 Account Amount (PKR)" FontWeight="SemiBold"
                       Margin="0 0 0 4" Foreground="#1D4ED8"/>
            <TextBox x:Name="txtAccount" Height="36" Padding="10 0"
                     VerticalContentAlignment="Center" FontSize="14"
                     BorderBrush="#E2E8F0" BorderThickness="1.5"
                     Text="0" TextChanged="Recalculate"/>
        </StackPanel>

        <!-- Total display -->
        <Border Grid.Row="3" Background="#EFF6FF" CornerRadius="6"
                Padding="10 8" Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total Payment:" FontWeight="Bold" Margin="0 0 8 0"/>
                <TextBlock x:Name="txtTotalDisplay" FontWeight="Bold"
                           FontSize="15" Foreground="#1D4ED8"/>
            </StackPanel>
        </Border>

        <!-- Remarks -->
        <StackPanel Grid.Row="4" Margin="0 0 0 12">
            <TextBlock Text="Remarks (optional)" FontWeight="SemiBold"
                       Margin="0 0 0 4" Foreground="#64748B"/>
            <TextBox x:Name="txtRemarks" Height="36" Padding="10 0"
                     VerticalContentAlignment="Center" FontSize="13"
                     BorderBrush="#E2E8F0" BorderThickness="1.5"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="36" Margin="0 0 10 0"
                    Background="#64748B" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="✔ Confirm Payment" Width="155" Height="36"
                    Background="#16A34A" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
